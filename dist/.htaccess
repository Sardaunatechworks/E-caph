# ============================================================================
# e-CAPH System Apache Configuration (Optimized for cPanel / Apache)
# ============================================================================

# 1. Correct MIME Types (Prevents CSS/JS MIME-type blocking)
<IfModule mod_mime.c>
  AddType text/css .css
  AddType application/javascript .js .mjs
  AddType application/json .json
  AddType text/plain .txt
  AddType image/svg+xml .svg .svgz
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType application/pdf .pdf
</IfModule>

# 2. Enable Gzip Compression for Fast Loading
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# 3. Cache-Control Headers (Ensures instant updates after deployment)
<IfModule mod_headers.c>
  # Default: NEVER cache HTML, directory routes, clean URLs, or RSC prefetch data
  Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
  Header set Pragma "no-cache"
  Header set Expires 0
  Header set X-LiteSpeed-Cache-Control "no-cache"

  # Cache immutable static assets (media, fonts)
  <FilesMatch "\.(woff2|woff|ttf|png|jpg|jpeg|gif|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Cache static Next.js JS/CSS chunks, but NEVER fallbacks
  <FilesMatch "^(?!fallback).*\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Explicitly ensure fallbacks are never cached
  <FilesMatch "fallback\.(js|css)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires 0
    Header set X-LiteSpeed-Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# 4. Disable Directory Browsing & MultiViews
Options -Indexes -MultiViews
RewriteEngine On
RewriteBase /

# 5. Force HTTPS Security
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 6. SERVE EXISTING STATIC FILES & DIRECTORIES DIRECTLY FIRST
# (Never rewrite real files - ensures existing CSS, JS, fonts, images are served directly without interference)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 7. Safe font compatibility alias (only rewrites if the alternate file actually exists on disk, preventing 500 loop)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/_next/static/media/$1-s.$2 -f
RewriteRule ^_next/static/media/(.+)-s\.p\.(.+\.woff2)$ _next/static/media/$1-s.$2 [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/_next/static/media/$1-s.p.$2 -f
RewriteRule ^_next/static/media/(.+)-s\.(.+\.woff2)$ _next/static/media/$1-s.p.$2 [L]

# 8. Chunk compatibility fallback (prevents 404 & ChunkLoadError for any missing chunk from older builds)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^_next/static/chunks/(.+)\.js$ _next/static/chunks/fallback.js [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^_next/static/chunks/(.+)\.css$ _next/static/chunks/fallback.css [L]

# 9. Clean URLs: rewrite /page/ to /page/index.html if exists
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ $1/index.html [L]

# 10. Clean URLs: rewrite /page to /page/index.html if directory/index.html exists
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ $1/index.html [L]

# 11. Clean URLs: rewrite /page to /page.html if exists
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# 12. Dynamic Blog/Stories/Publications fallback:
# If a /blog/<slug> URL is requested and doesn't exist statically on disk,
# rewrite internally to blog/view/index.html so the client can load the post dynamically
RewriteCond %{REQUEST_URI} ^/blog/ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteRule ^blog/(.+)$ blog/view/index.html [L]

# 13. Fallback 404
ErrorDocument 404 /404/index.html
